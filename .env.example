#catálogo
SESSION_SECRET= # Chave da sessão, gerei a minha por esta site: https://randomkeygen.com
PORT_CATALOGO=3000
TMDB_API_KEY= # Chave da API TMDB
AUTH_SERVICE_URL=http://auth-service:4000
LOG_SERVICE_URL=http://log-service:5000
PROFILE_SERVICE_URL=http://profile-service:4100
PAGAMENTOS_SERVICE_URL=http://pagamentos:4200 # URL interna do serviço de pagamentos (rede do Docker)
JWT_SECRET= # Chave JWT, gerada também à partir de: https://randomkeygen.com

#auth-service
PORT_AUTH=4000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER= # Seu usuário SMTP
SMTP_PASS= # Seu Hash para acessar seu serviço SMTP
APP_URL= # URL pública do catálogo, sem barra no final. Local: http://localhost:3000 | Produção: https://seu-dominio.com (sem porta). Usada no link de e-mail e nas URLs de retorno do checkout do Stripe

#Segredo das rotas internas (catalogo, auth-service e pagamentos)
#Precisa ser IDÊNTICO nos três. Gere com: openssl rand -hex 32
#Em produção (Portainer), use um valor DIFERENTE do local.
INTERNAL_API_KEY= # Segredo compartilhado das rotas internas que mudam permissão ou cobram

#pagamentos (Stripe -- SEMPRE em modo de teste nesta atividade)
#O número do cartão nunca passa pelo nosso sistema: é digitado numa página hospedada pelo Stripe.
PORT_PAGAMENTOS=4200 #Porta destinada ao serviço de pagamentos (sem porta publicada)
STRIPE_SECRET_KEY= # Chave secreta de TESTE (sk_test_...) -- painel do Stripe: Developers > API keys
STRIPE_WEBHOOK_SECRET= # whsec_... -- LOCAL: o impresso por "npm run stripe:listen" | PRODUÇÃO: o do endpoint cadastrado no painel (os dois são diferentes)
STRIPE_PRICE_FAN= # price_... do plano Fan (R$ 9,90/mês, recorrente, BRL) -- painel: Product catalog
STRIPE_PRICE_CINEFILO= # price_... do plano Cinéfilo (R$ 29,90/mês, recorrente, BRL)
STRIPE_PRICE_STALKER= # price_... do plano Stalker (R$ 99,90/mês, recorrente, BRL)

#Banco
DB_HOST= #ip do seu banco
DB_USER= # Usuário do seu banco
DB_PASSWORD= # Senha do seu banco
DB_NAME= # nome do seu banco

#Serviço de LOG
PORT_LOG= #Porta destinada ao serviço de LOG
REDIS_HOST=redis
REDIS_PORT=6379

#profile-service (upload de foto de perfil)
PORT_PROFILE=4100 #Porta destinada ao serviço de perfil

#Garage (object storage compatível com S3, self-hosted)
#Só existe o endpoint interno -- o navegador NUNCA fala com o Garage direto, só o
#profile-service, pela rede interna do Docker. A foto é servida via proxy no catalogo
#(GET /api/perfil/:usuario_id/foto), não por URL pública nem assinada.
GARAGE_ENDPOINT=http://garage:3900
GARAGE_REGION=garage #região configurada no garage.toml
GARAGE_BUCKET=avatars #bucket dedicado às fotos de perfil
GARAGE_ACCESS_KEY_ID= #Key ID gerado pelo bootstrap do Garage (upload-profile/garage/init-garage.sh)
GARAGE_SECRET_ACCESS_KEY= #Secret gerado pelo bootstrap do Garage
PROFILE_IMAGE_MAX_SIZE_MB=5 #tamanho máximo aceito por upload (catalogo e profile-service)