#catálogo
SESSION_SECRET= # Chave da sessão, gerei a minha por esta site: https://randomkeygen.com
PORT_CATALOGO=3000
TMDB_API_KEY= # Chave da API TMDB
AUTH_SERVICE_URL=http://auth-service:4000
LOG_SERVICE_URL=http://log-service:5000
PROFILE_SERVICE_URL=http://profile-service:4100
JWT_SECRET= # Chave JWT, gerada também à partir de: https://randomkeygen.com

#auth-service
PORT_AUTH=4000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER= # Seu usuário SMTP
SMTP_PASS= # Seu Hash para acessar seu serviço SMTP
APP_URL= # Seu domínio ou localhost

#Banco
DB_HOST= #ip do seu banco
DB_USER= # Usuário do seu banco
DB_PASSWORD= # Senha do seu banco
DB_NAME= # nome do seu banco

#Serviço de LOG
PORT_LOG= #Porta destinada ao serviço de LOG
REDIS_HOST=redis
REDIS_PORT=6379

#profile-service (upload de foto de perfil)
PORT_PROFILE=4100 #Porta destinada ao serviço de perfil

#Garage (object storage compatível com S3, self-hosted)
#Só existe o endpoint interno -- o navegador NUNCA fala com o Garage direto, só o
#profile-service, pela rede interna do Docker. A foto é servida via proxy no catalogo
#(GET /api/perfil/:usuario_id/foto), não por URL pública nem assinada.
GARAGE_ENDPOINT=http://garage:3900
GARAGE_REGION=garage #região configurada no garage.toml
GARAGE_BUCKET=avatars #bucket dedicado às fotos de perfil
GARAGE_ACCESS_KEY_ID= #Key ID gerado pelo bootstrap do Garage (upload-profile/garage/init-garage.sh)
GARAGE_SECRET_ACCESS_KEY= #Secret gerado pelo bootstrap do Garage
PROFILE_IMAGE_MAX_SIZE_MB=5 #tamanho máximo aceito por upload (catalogo e profile-service)